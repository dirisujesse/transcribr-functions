{
  "functions": [
    {
      "source": "transcribr-functions",
      "codebase": "transcribr-functions",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*-debug.log",
        "*.local",
        "src/**",
        "tsconfig*.json",
        "eslint.config.mjs"
      ],
      "predeploy": [
        "pnpm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "firestore": {
    "database": "wait-list",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
